# app shortcuts
ctrl + alt + cmd - t: open -n /Applications/WezTerm.app

# reload shortcut
shift + ctrl + alt + cmd - r: skhd --restart-service && yabai --restart-service

# window focus
ctrl + alt - down: yabai -m window --focus south
ctrl + alt - left: yabai -m window --focus west
ctrl + alt - right: yabai -m window --focus east
ctrl + alt - up: yabai -m window --focus north

# window movement
alt + cmd - down: yabai -m window --warp south
alt + cmd - left: yabai -m window --warp west
alt + cmd - right: yabai -m window --warp east
alt + cmd - up: yabai -m window --warp north

alt - 1: yabai -m space --focus 1; yabai -m query --windows --space 1 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 2: yabai -m space --focus 2; yabai -m query --windows --space 2 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 3: yabai -m space --focus 3; yabai -m query --windows --space 3 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 4: yabai -m space --focus 4; yabai -m query --windows --space 4 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 5: yabai -m space --focus 5; yabai -m query --windows --space 5 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 6: yabai -m space --focus 6; yabai -m query --windows --space 6 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 7: yabai -m space --focus 7; yabai -m query --windows --space 7 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 8: yabai -m space --focus 8; yabai -m query --windows --space 8 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true
alt - 9: yabai -m space --focus 9; yabai -m query --windows --space 9 | jq -r 'if length > 0 then .[0].id else empty end' | xargs -I {} yabai -m window {} --focus 2>/dev/null || true

# move window to workspace
shift + alt - 1: yabai -m window --space 1
shift + alt - 2: yabai -m window --space 2
shift + alt - 3: yabai -m window --space 3
shift + alt - 4: yabai -m window --space 4
shift + alt - 5: yabai -m window --space 5
shift + alt - 6: yabai -m window --space 6
shift + alt - 7: yabai -m window --space 7
shift + alt - 8: yabai -m window --space 8
shift + alt - 9: yabai -m window --space 9

# move window to monitor
shift + ctrl + alt - 1: yabai -m window --display north
shift + ctrl + alt - 2: yabai -m window --display south

# window resizing
alt + cmd - b: yabai -m space --balance
alt + cmd - 0x18: yabai -m window --resize right:-20:0 2> /dev/null || yabai -m window --resize left:-20:0 2> /dev/null
alt + cmd - 0x1B: yabai -m window --resize right:20:0 2> /dev/null || yabai -m window --resize left:20:0 2> /dev/null
ctrl + alt - 0x18: yabai -m window --resize top:0:-20 2> /dev/null || yabai -m window --resize bottom:0:-20 2> /dev/null
ctrl + alt - 0x1B: yabai -m window --resize top:0:20 2> /dev/null || yabai -m window --resize bottom:0:20 2> /dev/null

# window fullscreen
alt + ctrl + cmd - f: yabai -m window --toggle zoom-fullscreen

# window floating
shift + alt + ctrl + cmd - f: yabai -m window --toggle float
